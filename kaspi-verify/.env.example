# ── Supabase (server-side, service role bypasses RLS for verification) ──
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ── OpenAI Vision (OCR) ──
OPENAI_API_KEY=sk-...
OPENAI_VISION_MODEL=gpt-4o

# ── Business rules ──
# Fallback amount if a plan is unknown (₸)
PREMIUM_AMOUNT=990
# Per-plan amounts (₸) — must match the tariff prices shown on the site.
# Receipt amount must equal the amount of the selected plan.
AMOUNT_STANDARD=1590
AMOUNT_CAREER=2590
AMOUNT_REPORT990=990
# The Kaspi account holder the transfer must be sent to (as printed on the receipt)
EXPECTED_RECEIVER=Мадина Е.
# Payment window (minutes): the receipt time must be within this window
# starting from order creation. The site shows a 6-minute countdown.
RECEIPT_MAX_AGE_MINUTES=6
# Minimum OCR confidence (0..1) to accept automatically
MIN_OCR_CONFIDENCE=0.75
# Premium length granted per successful payment (days)
PREMIUM_DAYS=30

# ── Kaspi Pay gateway (tapter-dev/kaspi-pos-automation) — real QR auto-confirm ──
# URL of the deployed kaspi-pos-automation server
KASPI_GATEWAY_URL=https://your-kaspi-gateway.example.com
# Session headers obtained once via the gateway's /api/auth flow
KASPI_TOKEN_SN=
KASPI_VTOKEN_SECRET=
KASPI_PROFILE_ID=
# Shared secret configured in the gateway's webhooks.json (HMAC SHA-256)
KASPI_WEBHOOK_SECRET=your-webhook-secret

# Allow the static site origin to call the API
ALLOWED_ORIGIN=https://shyraq.asia

# ── Admin panel ──
# Secret token the admin panel sends (x-admin-token) to read all orders.
# Generate a long random string, e.g.: openssl rand -hex 24
ADMIN_TOKEN=
