# ── Supabase (server-side, service role bypasses RLS for verification) ──
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ── OpenAI Vision (OCR) ──
OPENAI_API_KEY=sk-...
OPENAI_VISION_MODEL=gpt-4o

# ── Business rules ──
# Exact amount that must appear on the receipt (₸)
PREMIUM_AMOUNT=990
# The Kaspi account holder the transfer must be sent to (as printed on the receipt)
EXPECTED_RECEIVER=Мадина Е.
# How fresh the receipt must be (minutes)
RECEIPT_MAX_AGE_MINUTES=30
# Minimum OCR confidence (0..1) to accept automatically
MIN_OCR_CONFIDENCE=0.75
# Premium length granted per successful payment (days)
PREMIUM_DAYS=30

# Allow the static site origin to call the API
ALLOWED_ORIGIN=https://kunanbayy.github.io
